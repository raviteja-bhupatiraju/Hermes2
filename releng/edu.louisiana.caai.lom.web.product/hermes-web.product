<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>
<!-- Hermes 2 Web: an OSGi server (Equinox, Jetty) serving the RAP application at http://<host>:8080/hermes. Started
     with hermes-web (or hermes-web.cmd); no native launcher. -->
<product name="Hermes 2 Web" uid="edu.louisiana.caai.lom.web.product" version="1.0.0.qualifier" type="features"
      includeLaunchers="false" autoIncludeRequirements="true">
   <configIni use="default">
   </configIni>
   <features>
      <feature id="edu.louisiana.caai.lom.web.feature"/>
   </features>
   <configurations>
      <plugin id="org.apache.felix.scr" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.rap.http.jetty" autoStart="true" startLevel="3" />
      <plugin id="org.eclipse.rap.http.registry" autoStart="true" startLevel="3" />
      <plugin id="org.eclipse.rap.rwt.osgi" autoStart="true" startLevel="3" />
      <plugin id="edu.louisiana.caai.lom.web" autoStart="true" startLevel="4" />
      <!-- A server: no Eclipse application; the framework keeps running. -->
      <property name="eclipse.ignoreApp" value="true" />
      <property name="osgi.noShutdown" value="true" />
      <!-- The port (also -Dorg.osgi.service.http.port=... on the command line). -->
      <property name="org.osgi.service.http.port" value="8080" />
      <property name="org.eclipse.rap.http.jetty.http.port" value="8080" />
   </configurations>
</product>
