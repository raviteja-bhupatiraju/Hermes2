<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>

<product name="Hermes 2: MedBiquitous Editor" uid="edu.louisiana.caai.lom.product" id="edu.louisiana.caai.lom.editor.product" application="edu.louisiana.caai.lom.editor.HlomEditorAdvisorApplication" version="1.0.0.qualifier" type="features" includeLaunchers="true" autoIncludeRequirements="true">

   <aboutInfo>
      <text>
         Hermes 2: MedBiquitous Editor

An editor for the MedBiquitous standards: Healthcare LOM, Curriculum Inventory, Competency Framework, Competency Object, Performance Framework, Activity Report, Medical Education Metrics, Healthcare Professional Profile and Virtual Patient documents.

Ravi Teja Bhupatiraju, University of Louisiana at Lafayette, Center for Applied Artificial Intelligence (CAAI)
      </text>
   </aboutInfo>

   <configIni use="default">
   </configIni>

   <launcherArgs>
      <programArgs>-showsplash edu.louisiana.caai.lom.editor --launcher.defaultAction openFile
      </programArgs>
      <vmArgs>-Xms64m
-Xmx2g
-XX:+UseG1GC
-XX:GCTimeRatio=4
-XX:MinHeapFreeRatio=10
-XX:MaxHeapFreeRatio=30
-XX:G1PeriodicGCInterval=60000
-XX:+UseStringDeduplication
      </vmArgs>
      <vmArgsMac>-XstartOnFirstThread
      </vmArgsMac>
   </launcherArgs>

   <windowImages i16="/edu.louisiana.caai.lom.editor/icons/app/hlom16.png" i32="/edu.louisiana.caai.lom.editor/icons/app/hlom32.png" i48="/edu.louisiana.caai.lom.editor/icons/app/hlom48.png" i64="/edu.louisiana.caai.lom.editor/icons/app/hlom64.png" i128="/edu.louisiana.caai.lom.editor/icons/app/hlom128.png" i256="/edu.louisiana.caai.lom.editor/icons/app/hlom256.png"/>

   <splash
      location="edu.louisiana.caai.lom.editor"
      startupProgressRect="40,272,440,4"
      startupMessageRect="40,250,440,16"
      startupForegroundColor="475569" />

   <launcher name="Hermes2">
      <win useIco="true">
         <ico path="../../bundles/edu.louisiana.caai.lom.editor/icons/app/hlom.ico"/>
         <bmp/>
      </win>
      <linux icon="../../bundles/edu.louisiana.caai.lom.editor/icons/app/hlom.xpm"/>
      <macosx icon="../../bundles/edu.louisiana.caai.lom.editor/icons/app/hlom.icns"/>
   </launcher>

   <vm>
   </vm>

   <plugins>
   </plugins>

   <features>
      <feature id="edu.louisiana.caai.lom.feature"/>
      <!-- The yearly terminologies: features of their own, so that a new release is an update of its own. -->
      <feature id="edu.louisiana.caai.terminology.mesh.feature" installMode="root"/>
      <feature id="edu.louisiana.caai.terminology.icd10cm.feature" installMode="root"/>
      <!-- Help > Check for Updates / Install New Software, Preferences > Install/Update (p2). -->
      <feature id="org.eclipse.equinox.p2.user.ui" installMode="root"/>
      <feature id="org.eclipse.rcp" installMode="root"/>
      <feature id="org.eclipse.help" installMode="root"/>
      <feature id="org.eclipse.emf.common" installMode="root"/>
      <feature id="org.eclipse.emf.ecore" installMode="root"/>
      <feature id="org.eclipse.emf.edit" installMode="root"/>
      <feature id="org.eclipse.emf.common.ui" installMode="root"/>
      <feature id="org.eclipse.emf.edit.ui" installMode="root"/>
      <feature id="org.eclipse.emf.databinding" installMode="root"/>
      <feature id="org.eclipse.emf.databinding.edit" installMode="root"/>
      <!-- Optional Git version control: inactive until a project is shared with Git (Team > Share Project) -->
      <feature id="org.eclipse.egit" installMode="root"/>
      <feature id="org.eclipse.jgit" installMode="root"/>
      <!-- The Java runtime (Eclipse JustJ, OpenJDK 27 without debug symbols): no Java installation is needed,
           and updates of Java come with Help > Check for Updates. -->
      <feature id="org.eclipse.justj.openjdk.hotspot.jre.full.stripped" installMode="root"/>
   </features>

   <configurations>
      <!-- The workspace (preferences, open projects, layout) lives in the user's home, so that the application
           also works when installed in a read-only folder such as Program Files. -->
      <property name="osgi.instance.area.default" value="@user.home/.hermes2/workspace" />
      <plugin id="org.apache.felix.scr" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.core.runtime" autoStart="true" startLevel="0" />
      <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.event" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.simpleconfigurator" autoStart="true" startLevel="1" />
      <!-- NatTable's Eclipse Collections: the mediator registers the implementation's services when it starts. -->
      <plugin id="org.apache.aries.spifly.dynamic.bundle" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.collections.impl" autoStart="true" startLevel="3" />
   </configurations>

</product>
