<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (c) 2026 University of Louisiana at Lafayette, CAAI.

     The command line tool and language server as a plain Java program (no OSGi): target/cli/ holds hermes.jar
     (main class and class path only), lib/ with the CLI, model and EMF jars, and the hermes / hermes.cmd launchers;
     target/hermes-cli-1.0.0.zip is the same folder for download. The product includes target/cli/ as cli/. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>edu.louisiana.caai</groupId>
    <artifactId>edu.louisiana.caai.lom.parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>edu.louisiana.caai.lom.cli.dist</artifactId>
  <packaging>jar</packaging>
  <name>Hermes 2 command line tool (distribution)</name>

  <properties>
    <cli.dir>${project.build.directory}/cli</cli.dir>
    <emf.common.version>2.46.0</emf.common.version>
    <emf.ecore.version>2.43.0</emf.ecore.version>
    <emf.xmi.version>2.41.0</emf.xmi.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>edu.louisiana.caai</groupId>
      <artifactId>edu.louisiana.caai.lom.cli</artifactId>
      <version>${project.version}</version>
      <!-- Only the jar: its OSGi requirements are not needed outside OSGi. -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>edu.louisiana.caai</groupId>
      <artifactId>edu.louisiana.caai.lom.model</artifactId>
      <version>${project.version}</version>
      <!-- Only the jar: its OSGi requirements are not needed outside OSGi. -->
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- The offline terminology index (a fragment of the model bundle): on the class path next to the model. -->
      <groupId>edu.louisiana.caai</groupId>
      <artifactId>edu.louisiana.caai.terminology.mesh</artifactId>
      <version>2026.0.0-SNAPSHOT</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- The offline terminology index (a fragment of the model bundle): on the class path next to the model. -->
      <groupId>edu.louisiana.caai</groupId>
      <artifactId>edu.louisiana.caai.terminology.icd10cm</artifactId>
      <version>2026.0.0-SNAPSHOT</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>edu.louisiana.caai</groupId>
      <artifactId>edu.louisiana.caai.medbiq.model</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.common</artifactId>
      <version>${emf.common.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore</artifactId>
      <version>${emf.ecore.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
      <version>${emf.xmi.version}</version>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-lib</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${cli.dir}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
              <useBaseVersion>true</useBaseVersion>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-scripts</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${cli.dir}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/scripts</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <outputDirectory>${cli.dir}</outputDirectory>
          <finalName>hermes</finalName>
          <skipIfEmpty>false</skipIfEmpty>
          <forceCreation>true</forceCreation>
          <archive>
            <manifest>
              <mainClass>edu.louisiana.caai.lom.cli.Hermes</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <useUniqueVersions>false</useUniqueVersions>
            </manifest>
            <manifestEntries>
              <Implementation-Title>Hermes 2 command line tool</Implementation-Title>
              <Implementation-Version>1.0.0</Implementation-Version>
              <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>zip</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/main/assembly/cli.xml</descriptor>
              </descriptors>
              <finalName>hermes-cli-1.0.0</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <attach>false</attach>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
