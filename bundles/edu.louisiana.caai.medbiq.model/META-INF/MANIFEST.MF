Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: edu.louisiana.caai.medbiq.model;singleton:=true
Automatic-Module-Name: edu.louisiana.caai.medbiq.model
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-25
Bundle-ClassPath: .
Bundle-ActivationPolicy: lazy
Bundle-Activator: edu.louisiana.caai.medbiq.model.MedbiqStandards$Activator
Export-Package: edu.louisiana.caai.medbiq.model,
 edu.louisiana.caai.medbiq.model.standards,
 edu.louisiana.caai.medbiq.model.forms
Require-Bundle: edu.louisiana.caai.lom.model;visibility:=reexport,
 org.eclipse.emf.ecore;visibility:=reexport,
 org.eclipse.emf.ecore.xmi;visibility:=reexport
Import-Package: org.osgi.framework;resolution:=optional
