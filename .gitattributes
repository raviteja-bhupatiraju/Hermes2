# Normalise line endings on commit; keep platform scripts in their native form.
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
mvnw text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.bmp binary
*.ico binary
*.icns binary
*.pdf binary
*.gz binary
*.zip binary
